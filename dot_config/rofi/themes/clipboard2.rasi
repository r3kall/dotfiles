/* icon-preview.rasi
 *
 * Layout:
 *   [ large top preview pane ]
 *   [ listview (1 column)     ]
 *
 * Run with (example):
 *   rofi -show drun -show-icons -theme icon-preview.rasi
 *
 * Note:
 *   The top pane is the `message` widget. Rofi cannot automatically
 *   mirror the *selected* entry's icon into this pane via theme alone.
 */

configuration {
  show-icons: true;
  sidebar-mode: false;
}

* {
  font: "JetBrains Mono 12";
  background: #0f111a;
  foreground: #cdd6f4;

  bg0: #0f111a;
  bg1: #151827;
  bg2: #1b2033;

  fg0: #cdd6f4;
  fg1: #a6adc8;

  accent: #89b4fa;

  border-radius: 16px;
  gap: 12px;
  padding: 16px;
}

window {
  width: 520px;
  /* pick one: fixed height or percentage */
  height: 620px;
  border: 2px;
  border-color: @bg2;
  border-radius: @border-radius;
  background-color: @bg0;
}

mainbox {
  spacing: @gap;
  padding: @padding;
  background-color: transparent;
}

message {
  /* the big top pane */
  margin: 0px;
  padding: 22px;
  border-radius: @border-radius;
  background-color: @bg1;
}

textbox {
  /* message text styling */
  text-color: @fg0;
  background-color: transparent;
  horizontal-align: 0.5;
  vertical-align: 0.5;

  /* make it “feel” like a large icon area */
  font: "JetBrains Mono 44";
  /* if you use markup in -mesg, keep this on */
  markup: true;
}

listview {
  columns: 1;
  lines: 10;

  fixed-height: true;
  dynamic: true;

  spacing: 10px;
  padding: 14px;

  border-radius: @border-radius;
  background-color: @bg1;

  scrollbar: true;
}

element {
  padding: 10px;
  border-radius: 12px;
  background-color: transparent;
  text-color: @fg0;
}

element normal.normal {
  background-color: transparent;
}

element selected.normal {
  background-color: @bg2;
  text-color: @fg0;
}

element-text {
  background-color: transparent;
  text-color: inherit;
}

element-icon {
  /* list icons */
  size: 1.4em;
  background-color: transparent;
}

inputbar {
  /* optional; hidden by default if you run drun, etc. */
  padding: 10px;
  border-radius: 12px;
  background-color: @bg1;
}

prompt {
  text-color: @fg1;
}

entry {
  text-color: @fg0;
  background-color: transparent;
}

scrollbar {
  width: 6px;
  handle-width: 6px;
  padding: 0;
  border-radius: 99px;
  background-color: transparent;
}

handle {
  border-radius: 99px;
  background-color: @bg2;
}
