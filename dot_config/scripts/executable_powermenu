#!/usr/bin/env bash

THEME="$HOME/.config/rofi/themes/powermenu.rasi"
UPTIME="$(uptime -p | sed -e 's/up //g')"

# Options
shutdown=""
reboot="󱄌"
lock=""
suspend=""
logout="󰿅"

rofi_cmd() {
  rofi -dmenu \
    -p "Goodbye ${USER}" \
    -mesg "Uptime: $UPTIME" \
    -theme "$THEME"
}

run_rofi() {
  echo -e "$lock\n$suspend\n$logout\n$reboot\n$shutdown" | rofi_cmd
}

# Execute Command
run_cmd() {
  if [[ $1 == '--shutdown' ]]; then
    systemctl poweroff
  elif [[ $1 == '--reboot' ]]; then
    systemctl reboot
  elif [[ $1 == '--suspend' ]]; then
    systemctl suspend
  elif [[ $1 == '--logout' ]]; then
    if command -v uwsm >/dev/null 2>&1 && uwsm check is-active; then
      uwsm stop
    else
      local session_id="${XDG_SESSION_ID:-}"
      if [[ -z "$session_id" ]]; then
        session_id="$(loginctl show-session auto --property=Id --value)" || return 1
      fi
      [[ -n "$session_id" ]] || return 1
      loginctl terminate-session "$session_id"
    fi
  elif [[ $1 == '--lock' ]]; then
    loginctl lock-session
  fi
}

# Actions
chosen="$(run_rofi)"
case ${chosen} in
$shutdown)
  run_cmd --shutdown
  ;;
$reboot)
  run_cmd --reboot
  ;;
$lock)
  run_cmd --lock
  ;;
$suspend)
  run_cmd --suspend
  ;;
$logout)
  run_cmd --logout
  ;;
esac
