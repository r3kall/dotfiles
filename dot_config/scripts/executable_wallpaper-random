#!/usr/bin/env bash
# Script for selecting wallpapers with rofi + awww

source "$(dirname -- "${BASH_SOURCE[0]}")/utils.sh"

# Variables
LOG="$HOME/.config/scripts/logs/$(basename -- "$0").log"
WALLPAPER_DIR="${HOME}/Pictures/wallpapers"
WALLPAPER_CURR="$HOME/.config/hypr/.current_wallpaper"

# awww transition config
FPS=60
TYPE="any"
DURATION=2
BEZIER=".42,.9,.91,.78"
AWWW_PARAMS=(--transition-fps "${FPS}"
  --transition-type "${TYPE}"
  --transition-duration "${DURATION}"
  --transition-bezier "${BEZIER}")

mkdir -p "$(dirname "$LOG")"
exec >"$LOG" 2>&1

FOCUSED_MONITOR=$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name')
[[ -z "$FOCUSED_MONITOR" ]] && notify_err_alt "Could not detect focused monitor"

# Checks
notify_miss_alt "bc"
notify_miss_alt "fd"
notify_miss_alt "awww"
notify_miss_alt "matugen"

reload() {
  pkill -SIGUSR2 -u "$UID" -x waybar || true
  pkill -SIGUSR2 -u "$UID" -x ghostty || true
}

applyImageWallpaper() {
  local img="$1"
  awww img -o "$FOCUSED_MONITOR" "${img}" "${AWWW_PARAMS[@]}"
  # Track current wallpaper
  ln -sfn -- "$img" "$WALLPAPER_CURR"
  # Animation timer
  sleep "$(echo "$DURATION + 0.25" | bc)"
  matugen -v --source-color-index 0 image "$img"
  reload
}

main() {
  local pics=()
  mapfile -d '' -t pics < <(fd -0 -i -t f -E .git '\.(jpg|jpeg|png|webp|gif|bmp|tiff)$' "$WALLPAPER_DIR")
  ((${#pics[@]})) || { notify_err_alt "No wallpapers found in $WALLPAPER_DIR"; return 1; }

  # Use date variable to increase randomness
  local randomNumber=$((($(date +%s) + RANDOM + $$)))
  local randomPicture="${pics[$((randomNumber % ${#pics[@]}))]}"

  # Keep the selected path, including subdirectories and spaces.
  local selectedFile="$randomPicture"

  if [[ -n "${selectedFile}" ]]; then
    applyImageWallpaper "${selectedFile}"
  else
    notify_err_alt "Image not found ${selectedFile}"
  fi
}

main
