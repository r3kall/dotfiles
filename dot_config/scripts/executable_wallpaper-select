#!/usr/bin/env bash
# Script for selecting wallpapers with rofi + awww

source "$(dirname -- "${BASH_SOURCE[0]}")/utils.sh"

# Variables
LOG="$HOME/.config/scripts/logs/$(basename -- "$0").log"
WALLPAPER_DIR="${HOME}/Pictures/wallpapers"
WALLPAPER_CURR="$HOME/.config/hypr/.current_wallpaper"
ROFI_THEME="${HOME}/.config/rofi/themes/wallpaper-select.rasi"

# awww transition config
FPS=60
TYPE="any"
DURATION=2
BEZIER=".42,.9,.91,.78"
AWWW_PARAMS=(--transition-fps "${FPS}"
  --transition-type "${TYPE}"
  --transition-duration "${DURATION}"
  --transition-bezier "${BEZIER}")

mkdir -p "$(dirname "$LOG")"
exec >"$LOG" 2>&1

# Checks
notify_miss_alt "bc"
notify_miss_alt "rofi"
notify_miss_alt "awww"
notify_miss_alt "matugen"

FOCUSED_MONITOR=$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name')
[[ -z "$FOCUSED_MONITOR" ]] && notify_err_alt "Could not detect focused monitor"

# Monitor details
scaleFactor=$(hyprctl monitors -j | jq -r --arg mon "$FOCUSED_MONITOR" '.[] | select(.name == $mon) | .scale')
monitorHeight=$(hyprctl monitors -j | jq -r --arg mon "$FOCUSED_MONITOR" '.[] | select(.name == $mon) | .height')

iconSize=$(echo "scale=1; ($monitorHeight * 3) / ($scaleFactor * 100)" | bc)
adjustedIconSize=$(echo "$iconSize" | awk '{if ($1 < 20) $1 = 20; if ($1 > 40) $1 = 40; print $1}')
ROFI_OVERRIDE="element-icon{size:${adjustedIconSize}%;}"

mapfile -d '' -t PICS < <(
  find -L "${WALLPAPER_DIR}" \
    -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.gif' -o -iname '*.webp' -o -iname '*.bmp' -o -iname '*.tiff' \) \
    -print0 |
    sort -z
)
((${#PICS[@]})) || { notify_err_alt "No wallpapers found in $WALLPAPER_DIR"; exit 1; }

# Use date variable to increase randomness
randomNumber=$((($(date +%s) + RANDOM + $$)))
randomPicture="${PICS[$((randomNumber % ${#PICS[@]}))]}"
randomChoice="[${#PICS[@]}] Random"

rofiCommand=(rofi -i -dmenu -format i -config "$ROFI_THEME" -theme-str "$ROFI_OVERRIDE")

menu() {
  # Random entry first
  printf "%s\x00icon\x1f%s\n" "$randomChoice" "$randomPicture"

  for picPath in "${PICS[@]}"; do
    picName=$(basename "$picPath")
    if [[ "${picName,,}" == *.gif ]]; then
      cacheKey=$(printf '%s' "$picPath" | sha256sum)
      cacheGifImage="${XDG_CACHE_HOME:-$HOME/.cache}/gif_preview/${cacheKey%% *}.png"
      if [[ ! -f "$cacheGifImage" || "$picPath" -nt "$cacheGifImage" ]]; then
        mkdir -p "$(dirname -- "$cacheGifImage")"
        if ! magick "${picPath}[0]" -thumbnail '1920x1080>' "$cacheGifImage"; then
          cacheGifImage="$picPath"
        fi
      fi
      printf "%s\x00icon\x1f%s\n" "$picName" "$cacheGifImage"
    else
      printf "%s\x00icon\x1f%s\n" "$picName" "$picPath"
    fi
  done
}

reload() {
  pkill -SIGUSR2 -u "$UID" -x waybar || true
  pkill -SIGUSR2 -u "$UID" -x ghostty || true
}

applyImageWallpaper() {
  local img="$1"
  awww img -o "$FOCUSED_MONITOR" "${img}" "${AWWW_PARAMS[@]}"
  # Track current wallpaper
  ln -sfn -- "$img" "$WALLPAPER_CURR"
  # Animation timer
  sleep "$(echo "$DURATION + 0.25" | bc)"
  matugen -v --source-color-index 0 image "$img"
  reload
}

main() {
  choice=$(menu | "${rofiCommand[@]}") || return 0

  # User cancelled
  [[ -z "${choice}" ]] && exit 0
  [[ "$choice" =~ ^[0-9]+$ ]] && ((choice <= ${#PICS[@]})) || return 1

  # Random selection
  if ((choice == 0)); then
    applyImageWallpaper "${randomPicture}"
    exit 0
  fi

  # Resolve the selected index to its full path, including subdirectories and spaces.
  selectedFile="${PICS[choice - 1]}"

  if [[ -n "${selectedFile}" ]]; then
    applyImageWallpaper "${selectedFile}"
  else
    notify_err_alt "Image not found ${choice}"
  fi
}

if pidof rofi >/dev/null; then
  pkill rofi
fi

main
