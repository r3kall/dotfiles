[Unit]
Description=Clipvault clipboard watcher (image)
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=/usr/bin/wl-paste --type image --watch /usr/bin/clipvault store
Restart=on-failure
RestartSec=30

[Install]
WantedBy=graphical-session.target
